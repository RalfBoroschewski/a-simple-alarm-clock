<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

	<modelVersion>4.0.0</modelVersion>
	<groupId>com.ralf</groupId>
	<artifactId>a-simple-alarm-clock</artifactId>
	<version>1.0-SNAPSHOT</version>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<maven.compiler.source>9</maven.compiler.source>
		<maven.compiler.target>9</maven.compiler.target>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.openjfx</groupId>
			<artifactId>javafx-controls</artifactId>
			<version>23.0.2</version>
		</dependency>
		<dependency>
			<groupId>org.openjfx</groupId>
			<artifactId>javafx-media</artifactId>
			<version>23.0.2</version>
		</dependency>

		<dependency>
			<groupId>io.github.classgraph</groupId>
			<artifactId>classgraph</artifactId>
			<version>4.8.184</version>
			<scope>compile</scope>
		</dependency>

	</dependencies>

	<build>
		<plugins>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.11.0</version>
			</plugin>


			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<version>3.3.0</version>
				<configuration>
					<archive>
						<manifest>
							<addClasspath>true</addClasspath>
							<mainClass>com.ralf.asac.Asac</mainClass>

						</manifest>
					</archive>
				</configuration>
			</plugin>


			<!-- COPY DEPENDENCIES -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<version>3.8.1</version>
				<executions>
					<execution>
						<id>copy-dependencies</id>
						<phase>prepare-package</phase>
						<goals>
							<goal>copy-dependencies</goal>
						</goals>
						<configuration>
							<outputDirectory>${project.build.directory}/used-libs</outputDirectory>
						</configuration>
					</execution>
				</executions>
			</plugin>


			<!-- CREATE DEB -->
			<plugin>
				<artifactId>jdeb</artifactId>
				<groupId>org.vafer</groupId>
				<version>1.14</version>
				<executions>
					<execution>
						<id>jdeb</id>
						<phase>package</phase>
						<goals>
							<goal>jdeb</goal>
						</goals>
						<configuration>
							<deb>${project.build.directory}/${artifactId}_${version}_all.deb</deb>
							<verbose>true</verbose>
							<snapshotExpand>true</snapshotExpand>
							<snapshotEnv>USER</snapshotEnv>
							<verbose>true</verbose>
							<controlDir>${basedir}/src/main/assembly/linux/deb/control</controlDir>

							<dataSet>
								<data>
									<src>${project.build.directory}/${project.build.finalName}.jar</src>
									<type>file</type>
									<mapper>
										<type>perm</type>
										<prefix>/usr/share/a-simple-alarm-clock</prefix>
										<user>root</user>
										<group>root</group>
										<filemode>0644</filemode>
									</mapper>
								</data>

								<!-- USES DEPENDENCIES -->
								<data>
									<src>${project.build.directory}/used-libs</src>
									<type>directory</type>
									<includes />
									<mapper>
										<type>perm</type>
										<prefix>/usr/share/a-simple-alarm-clock/lib</prefix>
										<user>root</user>
										<group>root</group>
										<filemode>0644</filemode>
									</mapper>
								</data>

								<!-- DIRECTORY conf -->
								<data>
									<src>${basedir}/src/main/assembly/linux/conf/</src>
									<type>directory</type>
									<includes />
									<mapper>
										<type>perm</type>
										<prefix>/usr/share/a-simple-alarm-clock/conf</prefix>
										<user>root</user>
										<group>root</group>
										<filemode>0644</filemode>
									</mapper>
								</data>

								<data>
									<src>${basedir}/src/main/assembly/linux/remains/alarm.png</src>
									<type>file</type>
									<mapper>
										<type>perm</type>
										<prefix>/usr/share/a-simple-alarm-clock</prefix>
										<user>root</user>
										<group>root</group>
										<filemode>0644</filemode>
									</mapper>
								</data>

								<data>
									<src>${basedir}/src/main/assembly//linux/remains/a-simple-alarm-clock.sh</src>
									<type>file</type>
									<mapper>
										<type>perm</type>
										<prefix>/usr/share/a-simple-alarm-clock</prefix>
										<user>root</user>
										<group>root</group>
										<filemode>0755</filemode>
									</mapper>
								</data>

								<data>
									<type>link</type>
									<symlink>true</symlink>
									<linkName>/usr/bin/a-simple-alarm-clock</linkName>
									<linkTarget>/usr/share/a-simple-alarm-clock/a-simple-alarm-clock.sh</linkTarget>
								</data>

								<data>
									<src>${basedir}/src/main/assembly/linux/remains/a-simple-alarm-clock.desktop</src>
									<type>file</type>
									<mapper>
										<type>perm</type>
										<prefix>/usr/share/applications</prefix>
										<user>root</user>
										<group>root</group>
										<filemode>0644</filemode>
									</mapper>
								</data>
							</dataSet>
						</configuration>
					</execution>
				</executions>
			</plugin>


			<!-- CREATE SHADED JAR -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-shade-plugin</artifactId>
				<version>3.5.1</version>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>shade</goal>
						</goals>
						<configuration>

							<shadedArtifactAttached>true</shadedArtifactAttached>
							<shadedClassifierName>SHADED</shadedClassifierName>

							<transformers>
								<transformer
									implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
									<mainClass>com.ralf.asac.Asac</mainClass>

									<manifestEntries>
										<Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
									</manifestEntries>

								</transformer>
							</transformers>
							<filters>
								<filter>
									<artifact>org.openjfx:javafx-controls</artifact>
									<includes>
										<include>**</include>
									</includes>
								</filter>
								<filter>
									<artifact>org.openjfx:javafx-media</artifact>
									<includes>
										<include>**</include>
									</includes>
								</filter>
							</filters>
						</configuration>
					</execution>
				</executions>
			</plugin>

		</plugins>
	</build>
</project>
